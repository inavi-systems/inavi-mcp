# Optional Environment Variables
# Uncomment and modify these if you want to override defaults
# NODE_ENV=development
# PORT=3000
# INAVI_DOMAIN=https://imaps.inavi.com
# Usage telemetry — set to false to opt out (see README "사용 통계 수집")
# INAVI_MCP_TELEMETRY=false
# Collector origin; point at the dev site when testing against it
# INAVI_MCP_TELEMETRY_URL=https://dev-mapsapi.inavisys.com
