{
  "id": "PolylineOptions",
  "category": "options",
  "kind": "type",
  "name": "PolylineOptions",
  "description": "폴리라인을 생성할 때 설정할 수 있는 옵션입니다.",
  "type": [
    "Object"
  ],
  "properties": [
    {
      "name": "map",
      "type": [
        "Map"
      ],
      "description": "지도 객체입니다.",
      "optional": true
    },
    {
      "name": "path",
      "type": [
        "Array.<LngLatLike>"
      ],
      "description": "폴리라인을 구성하는 좌표 배열입니다.",
      "optional": true
    },
    {
      "name": "draggable",
      "type": [
        "boolean"
      ],
      "description": "드래그 가능 여부입니다."
    },
    {
      "name": "zIndex",
      "type": [
        "number"
      ],
      "description": "폴리라인의 `z-index` 입니다. CSS 에서와 동일합니다."
    },
    {
      "name": "style",
      "type": [
        "LineStyle"
      ],
      "description": "폴리라인의 스타일입니다.",
      "optional": true
    }
  ],
  "examples": [
    "{\n  map: map,\n  path: [\n    [127.110, 37.402],\n    [127.2, 37.5],\n  ],\n  draggable: false,\n  zIndex: 2,\n  style: {\n    lineColor: \"red\",\n  },\n};"
  ],
  "relatedTypes": {
    "Map": "inavi.maps.Map",
    "LngLatLike": "LngLatLike",
    "LineStyle": "LineStyle"
  }
}