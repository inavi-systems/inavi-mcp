{
  "id": "CircleOptions",
  "category": "options",
  "kind": "type",
  "name": "CircleOptions",
  "description": "원을 생성할 때 설정할 수 있는 옵션입니다.",
  "type": [
    "Object"
  ],
  "properties": [
    {
      "name": "map",
      "type": [
        "Map"
      ],
      "description": "지도 객체입니다.",
      "optional": true
    },
    {
      "name": "position",
      "type": [
        "LngLatLike"
      ],
      "description": "원의 위치입니다.",
      "optional": true
    },
    {
      "name": "radius",
      "type": [
        "number"
      ],
      "description": "원의 반경입니다.(단위: km)"
    },
    {
      "name": "draggable",
      "type": [
        "boolean"
      ],
      "description": "드래그 가능 여부입니다."
    },
    {
      "name": "zIndex",
      "type": [
        "number"
      ],
      "description": "원의 `z-index` 입니다. CSS 에서와 동일합니다."
    },
    {
      "name": "style",
      "type": [
        "FillStyle"
      ],
      "description": "원의 스타일입니다.",
      "optional": true
    }
  ],
  "examples": [
    "{\n  map: map,\n  position: [127.110, 37.402],\n  radius: 0.5,\n  draggable: true,\n  zIndex: 2,\n  style: {\n    fillColor: \"red\",\n  }\n};"
  ],
  "relatedTypes": {
    "Map": "inavi.maps.Map",
    "LngLatLike": "LngLatLike",
    "FillStyle": "FillStyle"
  }
}