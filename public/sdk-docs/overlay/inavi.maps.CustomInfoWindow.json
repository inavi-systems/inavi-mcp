{
  "id": "inavi.maps.CustomInfoWindow",
  "category": "overlay",
  "kind": "class",
  "name": "CustomInfoWindow",
  "description": "커스텀 정보창 클래스입니다. 정보창의 기본 팝업 템플릿을 사용하지 않고,\n 옵션으로 전달한 content 값을 온전히 정보창으로 표시합니다. 기능은 정보창 객체와 동일합니다.",
  "ctor": {
    "signature": "new CustomInfoWindow(infoWindowOptions?={})",
    "params": [
      {
        "name": "infoWindowOptions",
        "type": [
          "InfoWindowOptions"
        ],
        "description": "정보창 생성을 위한 옵션입니다.",
        "optional": true,
        "default": "{}"
      }
    ]
  },
  "methods": [
    {
      "name": "getContent",
      "signature": "getContent() ⇒ string | HTMLElement",
      "description": "정보창의 내용을 반환합니다.\n #setContent 에서 설정한 내용을 그대로 반환합니다.",
      "params": [],
      "returns": [
        {
          "type": [
            "string",
            "HTMLElement"
          ],
          "description": ""
        }
      ]
    },
    {
      "name": "getMap",
      "signature": "getMap() ⇒ Map",
      "description": "정보창이 등록된 지도 객체를 반환합니다.",
      "params": [],
      "returns": [
        {
          "type": [
            "Map"
          ],
          "description": ""
        }
      ]
    },
    {
      "name": "getOpacity",
      "signature": "getOpacity() ⇒ number",
      "description": "정보창의 투명도를 반환합니다. 기본값은 `1` 입니다.",
      "params": [],
      "returns": [
        {
          "type": [
            "number"
          ],
          "description": ""
        }
      ]
    },
    {
      "name": "getPosition",
      "signature": "getPosition() ⇒ LngLat",
      "description": "정보창의 위치를 반환합니다.",
      "params": [],
      "returns": [
        {
          "type": [
            "LngLat"
          ],
          "description": ""
        }
      ]
    },
    {
      "name": "getVisible",
      "signature": "getVisible() ⇒ boolean",
      "description": "정보창의 표시 여부를 반환합니다.",
      "params": [],
      "returns": [
        {
          "type": [
            "boolean"
          ],
          "description": ""
        }
      ]
    },
    {
      "name": "getZIndex",
      "signature": "getZIndex() ⇒ number",
      "description": "정보창의 `z-index` 를 반환합니다. 기본값은 `0` 입니다.",
      "params": [],
      "returns": [
        {
          "type": [
            "number"
          ],
          "description": ""
        }
      ]
    },
    {
      "name": "off",
      "signature": "off(eventType?, listener?) ⇒ InfoWindow",
      "description": "정보창에 등록된 이벤트 리스너를 제거합니다.",
      "params": [
        {
          "name": "eventType",
          "type": [
            "string"
          ],
          "description": "제거할 이벤트 타입입니다. 전달하지 않으면, 정보창에 등록한 모든 리스너를 제거합니다.",
          "optional": true
        },
        {
          "name": "listener",
          "type": [
            "function"
          ],
          "description": "제거할 리스너입니다. 전달하지 않으면, 이벤트 타입에 대한 모든 리스너를 제거합니다.",
          "optional": true
        }
      ],
      "returns": [
        {
          "type": [
            "InfoWindow"
          ],
          "description": "이벤트 리스너가 등록되었던 정보창 객체입니다."
        }
      ]
    },
    {
      "name": "on",
      "signature": "on(eventType, listener, stopPropagation?=true) ⇒ InfoWindow",
      "description": "정보창에 이벤트 리스너를 등록합니다.",
      "params": [
        {
          "name": "eventType",
          "type": [
            "string"
          ],
          "description": "이벤트 타입입니다. 사용 가능한 이벤트 타입은 다음과 같습니다.<br>\n `mousedown`, `mouseup`, `click`, `dblclick`, `mousemove`, `mouseenter`, `mouseleave`,\n `mouseover`, `mouseout`, `contextmenu`, `touchstart`, `touchend`, `touchcancel`."
        },
        {
          "name": "listener",
          "type": [
            "function"
          ],
          "description": "이벤트 리스너입니다. 콜백 인자는 EventPayload 를 참고하세요."
        },
        {
          "name": "stopPropagation",
          "type": [
            "boolean"
          ],
          "description": "이벤트 전파 방지 여부입니다.\n `false` 인 경우, 화면상의 이벤트 발생 위치를 기준으로 정보창 엘리먼트 아래에 놓인 객체의 이벤트도 함께 실행합니다.",
          "optional": true,
          "default": "true"
        }
      ],
      "returns": [
        {
          "type": [
            "InfoWindow"
          ],
          "description": "이벤트가 발생한 정보창 객체입니다."
        }
      ]
    },
    {
      "name": "once",
      "signature": "once(eventType, listener, stopPropagation?=true) ⇒ InfoWindow",
      "description": "정보창에 한 번만 실행되는 이벤트 리스너를 등록합니다.",
      "params": [
        {
          "name": "eventType",
          "type": [
            "string"
          ],
          "description": "이벤트 타입입니다. 사용 가능한 이벤트 타입은 다음과 같습니다.<br>\n `mousedown`, `mouseup`, `click`, `dblclick`, `mousemove`, `mouseenter`, `mouseleave`,\n `mouseover`, `mouseout`, `contextmenu`, `touchstart`, `touchend`, `touchcancel`."
        },
        {
          "name": "listener",
          "type": [
            "function"
          ],
          "description": "이벤트 리스너입니다. 콜백 인자는 EventPayload 를 참고하세요."
        },
        {
          "name": "stopPropagation",
          "type": [
            "boolean"
          ],
          "description": "이벤트 전파 방지 여부입니다.\n `false` 인 경우, 화면상의 이벤트 발생 위치를 기준으로 정보창 엘리먼트 아래에 놓인 객체의 이벤트도 함께 실행합니다.",
          "optional": true,
          "default": "true"
        }
      ],
      "returns": [
        {
          "type": [
            "InfoWindow"
          ],
          "description": "이벤트가 발생한 정보창 객체입니다."
        }
      ]
    },
    {
      "name": "setContent",
      "signature": "setContent(content) ⇒ void",
      "description": "정보창의 내용을 설정합니다.",
      "params": [
        {
          "name": "content",
          "type": [
            "string",
            "HTMLElement"
          ],
          "description": "정보창에 표시할 내용입니다."
        }
      ],
      "returns": []
    },
    {
      "name": "setMap",
      "signature": "setMap(map?) ⇒ void",
      "description": "정보창을 등록할 지도 객체를 설정합니다. 파라미터를 전달하지 않으면 정보창이 지도에서 제거됩니다.",
      "params": [
        {
          "name": "map",
          "type": [
            "Map"
          ],
          "description": "지도 객체입니다.",
          "optional": true
        }
      ],
      "returns": []
    },
    {
      "name": "setOpacity",
      "signature": "setOpacity(opacity?=1) ⇒ void",
      "description": "정보창의 투명도를 설정합니다.",
      "params": [
        {
          "name": "opacity",
          "type": [
            "number"
          ],
          "description": "설정할 투명도입니다. 유효값의 범위는 `0`(투명) ~ `1`(불투명) 입니다.",
          "optional": true,
          "default": "1"
        }
      ],
      "returns": []
    },
    {
      "name": "setPosition",
      "signature": "setPosition(position) ⇒ void",
      "description": "정보창의 위치를 설정합니다.",
      "params": [
        {
          "name": "position",
          "type": [
            "LngLatLike"
          ],
          "description": "위치로 설정할 좌표입니다."
        }
      ],
      "returns": []
    },
    {
      "name": "setVisible",
      "signature": "setVisible(visibility?=false) ⇒ void",
      "description": "정보창의 표시 여부를 설정합니다.",
      "params": [
        {
          "name": "visibility",
          "type": [
            "boolean"
          ],
          "description": "표시 여부입니다.",
          "optional": true,
          "default": "false"
        }
      ],
      "returns": []
    },
    {
      "name": "setZIndex",
      "signature": "setZIndex(zIndex?=0) ⇒ void",
      "description": "정보창의 `z-index` 를 설정합니다.",
      "params": [
        {
          "name": "zIndex",
          "type": [
            "number"
          ],
          "description": "CSS 와 같은 개념의 `z-index` 입니다.",
          "optional": true,
          "default": "0"
        }
      ],
      "returns": []
    }
  ],
  "members": [],
  "events": [
    "mousedown",
    "mouseup",
    "click",
    "dblclick",
    "mousemove",
    "mouseenter",
    "mouseleave",
    "mouseover",
    "mouseout",
    "contextmenu",
    "touchstart",
    "touchend",
    "touchcancel"
  ],
  "augments": [
    "InfoWindow"
  ],
  "relatedTypes": {
    "Map": "inavi.maps.Map",
    "LngLat": "inavi.maps.LngLat",
    "InfoWindow": "inavi.maps.InfoWindow",
    "LngLatLike": "LngLatLike",
    "InfoWindowOptions": "InfoWindowOptions",
    "EventPayload": "EventPayload"
  }
}